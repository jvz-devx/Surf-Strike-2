# Copy to apps/server/.env (never commit the real file).

# Shared secret for POST /api/server. Same value as HOST_SECRET in the Vercel project. 32+ random chars,
# e.g. `openssl rand -hex 32`.
HOST_SECRET=

# Deployed Vercel app (no trailing slash), e.g. https://surf-strike-2.vercel.app
DISCOVERY_URL=

# Optional: URL of a fixed self-hosted server (e.g. https://surf.example.com).
# When set and healthy, ./start.sh and `pnpm host` refuse to overwrite or clear discovery.
# FIXED_SERVER_URL=

# Game server bind address and port (cloudflared forwards to it).
# HOST=127.0.0.1
PORT=27015

# SQLite file. Default: apps/server/data/surf.db
DB_PATH=

# Optional: path to the cloudflared binary. Default: ~/.local/bin/cloudflared, then PATH.
# CLOUDFLARED=

# Admin accounts (Esc menu > Admin: enable/disable maps, ban/unban, force map change).
# Comma-separated account usernames, case-insensitive. Admin is decided by the logged-in
# account only, never by display name. Unset: "tim". Set to empty for no admins.
ADMIN_USERNAMES=tim

# Self-hosted server hardening (see docs/hosting.md):
# TRUST_PROXY=loopback
# ALLOWED_ORIGINS=
# MAX_PER_IP=3
# MAX_PENDING_CONNECTIONS=16
# HELLO_TIMEOUT_MS=5000
# BACKUP_DIR=/data/backups
# BACKUP_INTERVAL_MS=3600000
# BACKUP_KEEP=48
